# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urbanpulse_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/urbanpulse_db

# Weather API Configuration
WEATHER_PROVIDER=open-meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_SECONDS=20

# Scheduler & Rate Limiting Configuration (Day 2)
COLLECTION_INTERVAL_MINUTES=15
API_RATE_LIMIT_DELAY_SECONDS=0.5
API_MAX_RETRIES=3
API_BACKOFF_FACTOR=1.0

# Data Quality Configuration (Day 2)
MAX_OBSERVATION_STALENESS_MINUTES=180
DQ_TEMP_MIN_C=-10.0
DQ_TEMP_MAX_C=60.0
DQ_HUMIDITY_MIN_PCT=0.0
DQ_HUMIDITY_MAX_PCT=100.0
DQ_WIND_MAX_KMH=300.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/weather_collector.log

# Anomaly Detection Engine Configuration (Day 3)
AD_MIN_HISTORY_OBSERVATIONS=5
AD_MAD_THRESHOLD_MODERATE=2.5
AD_MAD_THRESHOLD_SEVERE=3.5
AD_MAD_THRESHOLD_CRITICAL=5.0
AD_TEMP_DEVIATION_FLOOR_C=3.0
AD_RAIN_THRESHOLD_MM=5.0
AD_WIND_DEVIATION_FLOOR_KMH=15.0
AD_WIND_GUST_THRESHOLD_KMH=40.0
AD_IFOREST_MIN_SAMPLES=15
AD_IFOREST_CONTAMINATION=auto
AD_MODEL_VERSION=1.0.0

# Traffic Disruption Intelligence Configuration (TomTom Traffic / Routing)
TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=
TOMTOM_ROUTING_URL=https://api.tomtom.com/routing/1/calculateRoute
TRAFFIC_REQUEST_TIMEOUT_SECONDS=15
TRAFFIC_RATE_LIMIT_DELAY_SECONDS=0.5
TRAFFIC_MIN_HISTORY_OBSERVATIONS=5
TRAFFIC_MAD_THRESHOLD_MODERATE=2.0
TRAFFIC_MAD_THRESHOLD_SEVERE=3.0
TRAFFIC_MAD_THRESHOLD_CRITICAL=4.5
TRAFFIC_MIN_DEVIATION_SECONDS=180.0

